EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Временно, только для локальной разработки: true — пропускает экран входа
# и создаёт анонимную Supabase-сессию вместо email-кода. Нужно включить
# "Allow anonymous sign-ins" в Supabase: Authentication -> Settings.
# Для обычной работы оставить false/не задавать.
EXPO_PUBLIC_DEV_SKIP_LOGIN=false

# Разбор PDF-выписки в разделе «Финансы».
# ВНИМАНИЕ: EXPO_PUBLIC_* попадает в бандл приложения — ключ увидит любой,
# у кого есть сборка. Годится только для локальной проверки; для публикации
# запрос нужно унести на сервер (Supabase Edge Function).
EXPO_PUBLIC_OPENAI_API_KEY=sk-...
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
