EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Временно, только для локальной разработки: true — пропускает экран входа
# и сам логинится под dev-аккаунтом dev@notebook.local, который создаёт
# supabase/seed.sql. Для обычной работы оставить false/не задавать.
# На публичный деплой не класть: пускает в приложение кого угодно.
EXPO_PUBLIC_DEV_SKIP_LOGIN=false

# Вход через Google, только для локального Supabase: эти две переменные читает
# Supabase CLI при `supabase start` (см. [auth.external.google] в
# supabase/config.toml). Берутся из OAuth-клиента "Web application"
# в Google Cloud Console. Без префикса EXPO_PUBLIC_ — в бандл приложения
# они не попадают, и secret не должен попадать никогда.
# На облачном Supabase эти значения вводятся в панели, а не здесь.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Ключ для разбора PDF-выписки и чата («Финансы», «Чат»). Запрос уходит
# с сервера — через supabase/functions/openai-proxy, а не из бандла
# приложения. Локально читает supabase/config.toml ([edge_runtime.secrets]);
# на облачном Supabase задаётся отдельно: `supabase secrets set
# OPENAI_API_KEY=... --project-ref <ref>` (см. README).
OPENAI_API_KEY=sk-...
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
